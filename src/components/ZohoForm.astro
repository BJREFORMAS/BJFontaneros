---
import Icon from "../components/Icon.astro";

const { origin } = Astro.url;
const returnPath = `${origin}/gracias`;
---

<div class="wrapper bg-gray pb-5 pt-4">
    <div class="container px-4 py-2">
        <form
            id="webform957647000000719152"
            action="https://crm.zoho.eu/crm/WebToLeadForm"
            method="POST"
            accept-charset="UTF-8"
            class="zoho-form"
        >
            <input
                type="hidden"
                name="xnQsjsdp"
                value="7b03528d6f8dd79f007ea27d2715b5e10236d3ab8267fbe4cd92dc3a5fa10e9d"
            />
            <input
                type="hidden"
                name="xmIwtLD"
                value="32b846af9a7acba9f90887770c8f2fd1e340c93228aee83e14fe2e3b6f3b7e1d8e9156ca525fac3695119539101d87a7"
            />

            <input type="hidden" name="actionType" value="TGVhZHM=" />
            <input type="hidden" name="returnURL" value={returnPath} />

            <!-- **********************************  -->

            <div class="form-header text-center mb-5">
                <h2 class="fw-bold text-dark">¿Cómo podemos ayudarte?</h2>
                <p class="text-muted">
                    Déjanos tus datos y te contactaremos en menos de 24h.
                </p>
                <div class="d-flex justify-content-center">
                    <a
                        href="https://wa.me/34689766329"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="btn btn-whatsapp"
                    >
                        <Icon name="whatsapp" class="icon-social" />
                    </a>
                </div>
            </div>

            <input type="hidden" name="Lead Status" />

            <div class="mb-3">
                <label class="form-label"
                    >Nombre <span class="text-danger">*</span></label
                >
                <input
                    type="text"
                    name="Last Name"
                    class="form-control"
                    required
                />
            </div>

            <div class="mb-3">
                <label class="form-label"
                    >Teléfono <span class="text-danger">*</span></label
                >
                <input
                    type="text"
                    name="Mobile"
                    class="form-control"
                    required
                />
            </div>

            <div class="mb-3">
                <label class="form-label">Dirección - Ciudad</label>
                <input
                    type="text"
                    name="Address - City"
                    class="form-control"
                    maxlength="255"
                />
            </div>

            <div class="mb-3">
                <label class="form-label">Correo electrónico</label>
                <input
                    type="email"
                    name="Email"
                    class="form-control"
                    maxlength="100"
                />
            </div>

            <div class="mb-3">
                <label class="form-label">Tipo de servicio</label>
                <select name="Industry" class="form-select form-select-lg">
                    <option value="-None-" selected>-None-</option>
                    <option value="Reforma">Reforma</option>
                    <option value="Reparación">Reparación</option>
                    <option value="Mantenimiento">Mantenimiento</option>
                    <option value="Información">Información</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">¿Cómo nos conociste?</label>
                <select name="Lead Source" class="form-select form-select-lg">
                    <option value="-None-" selected>-None-</option>
                    <option value="Whatsapp">Whatsapp</option>
                    <option value="Instagram">Instagram</option>
                    <option value="TikTok">TikTok</option>
                    <option value="Referido">Referido</option>
                    <option value="Google">Google</option>
                    <option value="Web">Web</option>
                </select>
            </div>

            <div class="mb-4">
                <label class="form-label">Cuéntanos qué necesitas</label>
                <textarea name="Description" class="form-control" rows="3"
                ></textarea>
            </div>

            <div class="mb-3 d-flex justify-content-start gap-3">
                <button
                    id="submit-btn"
                    type="submit"
                    class="btn btn-primary px-4 py-2 fw-bold shadow-blue"
                    >Enviar Solicitud</button
                >
            </div>

            <div class="mt-4">
                <p class="text-left text-muted fs-6 fst-italic">
                    <small> *Trabajamos en Madrid y alrededores.</small>
                </p>
            </div>
        </form>
    </div>
</div>

<style>
    .zoho-form {
        max-width: 800px;
        margin: 0 auto;
        background-color: #fafafaaf;
        border-radius: 10px;
        padding: 48px 72px;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.1);
    }

    .limpiar-btn {
        border-color: #d4d4d4;
    }

    .btn-whatsapp {
        background-color: #25d366;
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 43px;
        height: 43px;
        border-radius: 10%;
        transition: transform 0.2s;

        &:hover {
            transform: scale(1.1);
        }
    }
</style>

<script>
    // form html
    const form = document.getElementById(
        "webform957647000000719152",
    ) as HTMLFormElement;

    form?.addEventListener("submit", (e) => {
        const lastName = (
            form.elements.namedItem("Last Name") as HTMLInputElement
        ).value;
        const phone = form.elements.namedItem("Mobile") as HTMLInputElement;
        const email = (form.elements.namedItem("Email") as HTMLInputElement)
            .value;
        const descriptionElement = form.elements.namedItem(
            "Description",
        ) as HTMLTextAreaElement;
        const submitBtn = document.getElementById(
            "submit-btn",
        ) as HTMLButtonElement;

        // Extra 'required'
        if (!lastName.trim() || !phone.value.trim()) {
            alert("El nombre y el teléfono son obligatorios.");
            e.preventDefault();
            return;
        }

        // Validar Email
        if (email.trim().length > 0) {
            const regex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!regex.test(email)) {
                alert("Introduzca un correo electrónico válido.");
                e.preventDefault();
                return;
            }
        }

        // Validar teléfono
        let phoneNumber = phone.value.trim().replace(/[\s\-\.]/g, "");

        if (/^[6789]\d{8}$/.test(phoneNumber)) {
            phoneNumber = "+34" + phoneNumber;
        } else if (/^34[6789]\d{8}$/.test(phoneNumber)) {
            phoneNumber = "+" + phoneNumber;
        }

        const spainPhoneRegex = /^\+34[6789]\d{8}$/;
        if (!spainPhoneRegex.test(phoneNumber)) {
            alert(
                "El número de teléfono no es válido. Debe tener 9 dígitos (ej: 600123123).",
            );
            e.preventDefault();
            return;
        }

        phone.value = phoneNumber;



        // Evita doble envío
        if (submitBtn) submitBtn.disabled = true;
    });
</script>
